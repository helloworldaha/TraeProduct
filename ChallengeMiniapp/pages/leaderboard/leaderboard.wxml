<view class="leaderboard-page">
  <view class="page-header animate-fadeIn">
    <view class="header-icon">🏆</view>
    <view class="header-title">历史排行榜</view>
  </view>

  <view wx:if="{{records.length === 0}}" class="empty-state animate-fadeIn" style="animation-delay: 0.2s;">
    <view class="empty-icon">📝</view>
    <view class="empty-text">暂无记录</view>
    <view class="empty-desc">快去挑战一下吧！</view>
  </view>

  <view wx:else class="records-list">
    <view 
      wx:for="{{records}}" 
      wx:key="index"
      class="record-item animate-fadeIn"
      style="animation-delay: {{0.1 + index * 0.1}}s;"
    >
      <leaderboard-item
        rank="{{index + 1}}"
        name="玩家"
        score="{{item.score}}"
        accuracy="{{item.accuracy}}"
        time="{{item.usedTime}}"
      />
    </view>
  </view>

  <view class="bottom-btn animate-fadeIn" style="animation-delay: 0.5s;">
    <view class="btn btn-secondary" bindtap="goBack">
      <text>返回首页</text>
    </view>
  </view>
</view>
