.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  padding: 30rpx;
}

.daily-banner {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.banner-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.badge {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.countdown {
  text-align: right;
}

.countdown-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.countdown-time {
  font-size: 36rpx;
  color: #ffd700;
  font-weight: bold;
  font-family: monospace;
}

.stats-section {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  color: #ffd700;
  font-weight: bold;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 10rpx;
}

.status-section {
  text-align: center;
  margin-bottom: 30rpx;
}

.status-badge {
  display: inline-block;
  background: rgba(102, 126, 234, 0.3);
  color: #8fd3f4;
  padding: 15rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

.status-badge.completed {
  background: rgba(100, 255, 100, 0.2);
  color: #84fab0;
}

.action-section {
  margin-bottom: 30rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-primary.disabled {
  opacity: 0.5;
}

.btn-text {
  margin-right: 15rpx;
}

.leaderboard-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 20rpx;
  text-align: center;
}

.leaderboard-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.leaderboard-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  padding: 20rpx;
}

.rank {
  width: 50rpx;
  font-size: 28rpx;
  color: #ffd700;
  font-weight: bold;
  text-align: center;
}

.avatar {
  font-size: 40rpx;
  margin: 0 20rpx;
}

.info {
  flex: 1;
}

.name {
  font-size: 28rpx;
  color: #fff;
}

.score {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.game-area {
  display: flex;
  flex-direction: column;
}

.game-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.combo-display,
.score-display,
.timer-display {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.combo-label,
.score-label,
.timer-icon {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.combo-value,
.score-value,
.timer-value {
  font-size: 36rpx;
  color: #ffd700;
  font-weight: bold;
}

.progress-bar {
  height: 10rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  transition: width 0.3s ease;
}

.progress-text {
  text-align: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  margin-bottom: 30rpx;
}

.question-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
}

.question-title {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 30rpx;
  line-height: 1.5;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.option-item {
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 15rpx;
  padding: 25rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.option-item.correct {
  background: rgba(100, 255, 100, 0.2);
  border-color: #84fab0;
}

.option-item.wrong {
  background: rgba(255, 100, 100, 0.2);
  border-color: #ff9a9e;
}

.option-text {
  font-size: 28rpx;
  color: #fff;
  flex: 1;
}

.option-icon {
  font-size: 32rpx;
  color: #84fab0;
}

.option-item.wrong .option-icon {
  color: #ff9a9e;
}
