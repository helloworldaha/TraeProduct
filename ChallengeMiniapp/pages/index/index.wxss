.page-container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

.particles-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}

.particle {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  background: rgba(240, 147, 251, 0.4);
  border-radius: 50%;
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.4;
  }
  50% {
    transform: translateY(-100rpx) scale(1.2);
    opacity: 0.8;
  }
}

.content {
  position: relative;
  z-index: 1;
  padding: 40rpx 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title-main {
  font-size: 72rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #00f5ff 0%, #ff00ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.high-score-card {
  background: linear-gradient(135deg, rgba(240, 147, 251, 0.2) 0%, rgba(245, 87, 108, 0.2) 100%);
  border-radius: 20rpx;
  padding: 25rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(240, 147, 251, 0.3);
}

.high-score-icon {
  font-size: 45rpx;
  margin-right: 20rpx;
}

.high-score-info {
  text-align: center;
}

.high-score-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 5rpx;
}

.high-score-value {
  font-size: 42rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.mode-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.mode-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
}

.mode-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 25rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.mode-card:active {
  transform: scale(0.95);
}

.mode-card.normal-mode {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.3) 0%, rgba(118, 75, 162, 0.3) 100%);
  border-color: rgba(102, 126, 234, 0.5);
}

.mode-card.daily-mode {
  background: linear-gradient(135deg, rgba(255, 193, 7, 0.3) 0%, rgba(255, 152, 0, 0.3) 100%);
  border-color: rgba(255, 193, 7, 0.5);
}

.mode-card.endless-mode {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.3) 0%, rgba(238, 90, 90, 0.3) 100%);
  border-color: rgba(255, 107, 107, 0.5);
}

.mode-card.achievement-mode {
  background: linear-gradient(135deg, rgba(100, 255, 100, 0.2) 0%, rgba(100, 200, 100, 0.2) 100%);
  border-color: rgba(100, 255, 100, 0.5);
}

.mode-icon {
  font-size: 45rpx;
  margin-bottom: 10rpx;
}

.mode-name {
  font-size: 26rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.mode-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

.btn-container {
  display: flex;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  border-radius: 45rpx;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  color: #fff;
}

.btn-text {
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 10rpx;
}

.btn-icon {
  font-size: 32rpx;
}

.features {
  display: flex;
  justify-content: space-around;
  margin-top: auto;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.feature-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fadeIn {
  animation: fadeIn 0.6s ease-out forwards;
  opacity: 0;
}

@keyframes glow {
  0%, 100% {
    filter: drop-shadow(0 0 20rpx rgba(0, 245, 255, 0.5));
  }
  50% {
    filter: drop-shadow(0 0 40rpx rgba(255, 0, 255, 0.5));
  }
}

.animate-glow {
  animation: glow 2s ease-in-out infinite;
}
