.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  padding: 30rpx;
}

.start-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.endless-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.badge-icon {
  font-size: 120rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.badge-text {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
  letter-spacing: 10rpx;
}

.game-desc {
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 40rpx;
  padding: 0 40rpx;
}

.best-record {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  width: 100%;
  margin-bottom: 40rpx;
}

.record-title {
  text-align: center;
  color: #ffd700;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.record-stats {
  display: flex;
  justify-content: space-around;
}

.stat {
  text-align: center;
}

.stat .value {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.stat .label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.start-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 30rpx 80rpx;
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.btn-text {
  margin-right: 15rpx;
}

.rules {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.rule-item {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.game-screen {
  display: flex;
  flex-direction: column;
}

.game-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.difficulty-badge {
  padding: 10rpx 25rpx;
  border-radius: 30rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.wrong-indicator {
  display: flex;
  gap: 10rpx;
}

.heart {
  font-size: 36rpx;
  color: #ff6b6b;
  transition: all 0.3s ease;
}

.heart.lost {
  color: rgba(255, 255, 255, 0.2);
  transform: scale(0.8);
}

.main-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
}

.stat-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  text-align: center;
  min-width: 150rpx;
}

.stat-card.combo-card {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.3) 0%, rgba(238, 90, 90, 0.3) 100%);
  border: 2rpx solid rgba(255, 107, 107, 0.5);
}

.stat-value {
  font-size: 40rpx;
  color: #ffd700;
  font-weight: bold;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.timer-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: conic-gradient(#ff6b6b 0%, rgba(255, 255, 255, 0.1) 0%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 40rpx;
  position: relative;
}

.timer-progress {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(#ff6b6b 0%, rgba(255, 255, 255, 0.1) 0%);
  transition: transform 0.1s linear;
}

.timer-center {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.timer-value {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
}

.question-area {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.question-number {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 15rpx;
}

.question-title {
  font-size: 32rpx;
  color: #fff;
  line-height: 1.5;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.option-item {
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 15rpx;
  padding: 25rpx;
}

.option-item.correct {
  background: rgba(100, 255, 100, 0.2);
  border-color: #84fab0;
}

.option-item.wrong {
  background: rgba(255, 100, 100, 0.2);
  border-color: #ff9a9e;
}

.option-text {
  font-size: 28rpx;
  color: #fff;
}

.exit-btn {
  margin-top: 30rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
}
