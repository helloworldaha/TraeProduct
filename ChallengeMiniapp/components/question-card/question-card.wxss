.question-card {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 30rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  animation: slideUp 0.5s ease-out forwards;
  opacity: 0;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.question-type {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
}

.question-number {
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
}

.question-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 30rpx;
  transition: all 0.3s ease;
  animation: fadeIn 0.4s ease-out forwards;
  opacity: 0;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.option-item:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.2);
}

.option-item.selected {
  border-color: #f093fb;
  background: rgba(240, 147, 251, 0.2);
}

.option-item.correct {
  border-color: #4ade80;
  background: rgba(74, 222, 128, 0.2);
}

.option-item.wrong {
  border-color: #f87171;
  background: rgba(248, 113, 113, 0.2);
}

.option-item.disabled {
  pointer-events: none;
}

.option-label {
  width: 50rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: white;
  line-height: 1.5;
}

.option-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-left: 15rpx;
}

.option-icon.correct {
  background: #4ade80;
  color: white;
}

.option-icon.wrong {
  background: #f87171;
  color: white;
}
