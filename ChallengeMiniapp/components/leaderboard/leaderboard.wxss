.leaderboard-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.rank {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank.top1 {
  background: linear-gradient(135deg, #f5af19 0%, #f12711 100%);
  box-shadow: 0 0 20rpx rgba(245, 175, 25, 0.5);
}

.rank.top2 {
  background: linear-gradient(135deg, #a8a8a8 0%, #636363 100%);
}

.rank.top3 {
  background: linear-gradient(135deg, #cd7f32 0%, #8b4513 100%);
}

.rank.normal {
  background: rgba(255, 255, 255, 0.2);
}

.player-info {
  flex: 1;
}

.player-name {
  font-size: 30rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
}

.player-stats {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.score {
  font-size: 36rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
